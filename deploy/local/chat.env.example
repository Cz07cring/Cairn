# ringharness 开发期 chat 后端覆盖（复制到仓库根 `.runtime/chat.env`）
#
# 场景：本机 PM2 Qwen :8001 被 OpenCode 占用时，Cursor / live 测改走 DeepSeek。
# 恢复本机 Qwen：删除 `.runtime/chat.env`。
#
# 生成方式（推荐）：
#   export DEEPSEEK_API_KEY=sk-...
#   uv run python scripts/use_deepseek_chat.py
#
# 优先级：进程显式 export > 本文件 > qwen.env
# 禁止错配：BASE 与 MODEL 须同属一端点（勿让进程 RING_LOCAL_QWEN_BASE=:8001
# 配上本文件的 deepseek-*）。probe_local_qwen / e2e4 live 会查 /v1/models，
# 不在目录则 CHAT_MODEL_MISMATCH 失败关闭。
# 授权：RING_CLOUD_MODE 只是部署层闸门；ModelProfile.cloud_mode 与
# cloud_provider_refs 仍须允许远程 provider_ref，否则 dispatch 403 CLOUD_MODE_DENIED。
#
# 手动示例（勿把真实 key 提交进 git）：

RING_CHAT_PROVIDER=deepseek
RING_CHAT_NOTE=dev-override-opencode-owns-local-qwen
RING_CHAT_CLOUD_PROVIDER_REF=deepseek:api
RING_CLOUD_MODE=PREAUTHORIZED
RING_LOCAL_QWEN_BASE=https://api.deepseek.com
RING_LOCAL_QWEN_API_KEY=sk-REPLACE_ME
RING_LOCAL_QWEN_MODEL=deepseek-flash
RING_LOCAL_QWEN_TIMEOUT=120
