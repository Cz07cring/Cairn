# 复制为 .env 或导出到 shell；勿提交真实密钥。
# 详见 README / AGENTS.md / doc/engineering/第三方联合开发.md

# RING_JWT_PUBLIC_KEY=
# RING_JWT_ISSUER=
# RING_JWT_AUDIENCE=
# RING_CURSOR_SECRET=

# RING_DATABASE_URL=
# RING_TEST_DATABASE_URL=

# RING_S3_ENDPOINT=
# RING_S3_BUCKET=
# RING_S3_ACCESS_KEY=
# RING_S3_SECRET_KEY=
# RING_S3_REGION=

# RING_TEST_S3_ENDPOINT=
# RING_TEST_S3_ACCESS_KEY=
# RING_TEST_S3_SECRET_KEY=

# RING_REPOSITORY_REFS=[]

# Temporal（可选；未设置则 Fake / idle）
# RING_TEMPORAL_TARGET=127.0.0.1:7233
# RING_TEMPORAL_NAMESPACE=default
# 可选：新 Goal 默认 TEMPORAL（缺省 LEGACY，勿在默认测试环境打开）
# RING_ORCHESTRATION_DEFAULT_BACKEND=TEMPORAL
# 可选：强制 TEMPORAL（须同时配置 RING_TEMPORAL_TARGET；禁止再 START LEGACY；
# 且全局 claim 不再领取任何 Goal 活动，除非显式 RING_LEGACY_CLAIM_DRAIN=1）
# RING_ORCHESTRATION_REQUIRE_TEMPORAL=1
# RING_LEGACY_CLAIM_DRAIN=1
# 可选：GoalWorkflow 观察轮次 / Continue-As-New（仅 RealTemporalClient 启动时）
# RING_GOAL_WORKFLOW_OBSERVE_MAX_TICKS=30
# RING_GOAL_WORKFLOW_ENABLE_CONTINUE_AS_NEW=0

# Runner → Control（RunActivation）
# RING_CONTROL_URL=http://127.0.0.1:58101
# RING_WORKER_JWT=
# RING_HARNESS_CHECKOUT=
# live 零工具 PLAN（打本地 Qwen；禁止 plan-fixture 冒充）
# RING_RUNNER_LIVE_DISPATCH=1
# RING_LOCAL_QWEN_MODEL=Qwen3.8-Flash-Next-Uncensored-Mixed-omlx
# 本机 MLX 可能很慢；默认 180s，可按需加大
# RING_LOCAL_QWEN_TIMEOUT=180

# Broker
# RING_BROKER_CONTROL_URL=
# RING_BROKER_WORKER_JWT=
# RING_BROKER_WORKSPACE_ROOT=
